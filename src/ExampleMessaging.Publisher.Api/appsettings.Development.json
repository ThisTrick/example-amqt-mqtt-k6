{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "MQTT": "mqtt://localhost:1883"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672
  },
  "MQTT": {
    "Server": "localhost",
    "Port": 1883
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "Properties": {
      "Environment": "Development"
    }
  }
}
