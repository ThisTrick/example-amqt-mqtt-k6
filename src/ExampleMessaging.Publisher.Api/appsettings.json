{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RabbitMQ": "amqp://guest:guest@localhost:5672/",
    "MQTT": "mqtt://localhost:1883"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "messaging.exchange",
    "QueuePrefix": "messaging.queue",
    "ConnectionTimeoutSeconds": 30,
    "HeartbeatSeconds": 60,
    "AutomaticRecoveryEnabled": true,
    "TopologyRecoveryEnabled": true
  },
  "MQTT": {
    "Server": "localhost",
    "Port": 1883,
    "ClientId": "ExampleMessaging.Publisher",
    "UserName": "",
    "Password": "",
    "KeepAlivePeriodSeconds": 60,
    "CleanSession": true,
    "ConnectTimeoutSeconds": 30,
    "TopicPrefix": "messaging/"
  },
  "HealthChecks": {
    "Enabled": true,
    "RabbitMQEnabled": true,
    "MQTTEnabled": true
  },
  "Metrics": {
    "Enabled": true,
    "PrometheusEnabled": true,
    "Port": 9090
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/publisher-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "ServiceName": "ExampleMessaging.Publisher.Api",
      "Environment": "Development"
    }
  }
}
