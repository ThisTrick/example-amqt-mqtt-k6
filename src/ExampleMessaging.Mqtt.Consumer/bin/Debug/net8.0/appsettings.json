{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "ExampleMessaging.Mqtt.Consumer": "Debug"
    }
  },
  "MqttConsumerConfig": {
    "Server": "localhost",
    "Port": 1883,
    "ClientId": "mqtt-consumer",
    "TopicFilters": [
      {
        "Topic": "messages/orders",
        "QualityOfServiceLevel": 1
      },
      {
        "Topic": "messages/inventory", 
        "QualityOfServiceLevel": 0
      },
      {
        "Topic": "messages/notifications",
        "QualityOfServiceLevel": 2
      },
      {
        "Topic": "messages/logs",
        "QualityOfServiceLevel": 0
      }
    ],
    "ConnectionTimeoutSeconds": 30,
    "KeepAliveSeconds": 60,
    "CleanSession": true,
    "RetryIntervalSeconds": 5,
    "MaxRetryAttempts": 3
  }
}